# Configuração do workshop Plena Alimentos.
# Copie este arquivo para .env e ajuste se precisar:  cp .env.example .env
# O docker-compose lê o .env automaticamente. Todos têm defaults, então funciona
# mesmo sem .env — mude só o que fizer sentido na sua máquina.

# --- PostgreSQL ---
POSTGRES_USER=plena
POSTGRES_PASSWORD=plena
POSTGRES_DB=plena

# Porta do Postgres no host (lado de fora). Mude se a 5544 já estiver em uso.
# Dentro dos containers o Postgres continua em postgres:5432.
POSTGRES_HOST_PORT=5544

# String de conexão usada pelos serviços (seed, análise). Use o host "postgres"
# (nome do serviço na rede do compose), não localhost.
DATABASE_URL=postgresql://plena:plena@postgres:5432/plena

# --- MCP servers ---
# Nível de log dos MCP (ERROR mantém o stdio limpo para o protocolo).
FASTMCP_LOG_LEVEL=ERROR
